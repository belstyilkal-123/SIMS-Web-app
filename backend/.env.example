# ================================================================
# AgriSmart SIMS — Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env
# ================================================================

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/smart_irrigation

# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# REQUIRED for ESP8266 requests — use a separate random 32+ character value
DEVICE_API_KEY=CHANGE_THIS_TO_A_SEPARATE_LONG_RANDOM_STRING

FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (no trailing slashes)
# Include both 5173 and 5174 — Vite auto-increments the port when 5173 is busy
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Alert phone number for critical automation alerts (Twilio)
ALERT_PHONE=+251911000000

# SMTP — leave blank in dev (reset link shown on screen instead)
# Supports Gmail App Passwords, Mailgun, SendGrid SMTP relay, etc.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=noreply@yourdomain.com

# Twilio SMS — optional, leave blank to use mock console logging
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
